{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "BUILD_TARGET=web pnpm --filter frontend exec vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://orus-2.onrender.com/api/:path*"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://orus-2.onrender.com/docs/:path*"
    },
    {
      "source": "/((?!api/|docs/).*)",
      "destination": "/index.html"
    }
  ]
}