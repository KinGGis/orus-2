# =====================================================
# WEALTHFOLIO CONFIGURATION
# =====================================================

# Database Configuration
# ----------------------
# SQLite (default for local/desktop use):
DATABASE_URL=../db/app.db

# PostgreSQL/Supabase (for cloud deployment):
# Uncomment and configure for Supabase:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Example:
# DATABASE_URL=postgresql://postgres.bujfwfqmfsgaibnmuvml:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Alternative Supabase config (direct connection - for migrations):
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Storage backend: "sqlite" or "postgres"
# WF_STORAGE_BACKEND=sqlite

# =====================================================
# INTEGRATIONS
# =====================================================

# SnapTrade Integration (Optional - Multi-broker aggregation)
# Get credentials from snaptrade.com dashboard
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Wealthfolio Connect - Required for cloud sync feature
CONNECT_AUTH_URL=https://your-auth-provider.example.com
CONNECT_AUTH_PUBLISHABLE_KEY=your-publishable-key
CONNECT_API_URL=https://api.wealthfolio.app
CONNECT_OAUTH_CALLBACK_URL=https://connect.wealthfolio.app/auth/callback
